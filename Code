    renderHeader(){ const s=this.state||{}; const on=!!s.boiler_on; const chip=$('#boilerChip'); chip.classList.toggle('ok',on); chip.classList.toggle('off',!on); chip.textContent='Kotel: '+(on?'Zapnuto':'Vypnuto'); $('#bandPill').textContent='Comfort band: '+fmt(s.comfort_band||2)+' °C'; $('#comfortBand').value=fmt(s.comfort_band||2,1); $('#m_rooms').textContent=(s.rooms||[]).length; $('#m_active').textContent=(s.rooms||[]).filter(r=>r.heating).length; const net=s.net||{}; const netStr=[net.ssid?`Wi‑Fi: ${net.ssid}`:null, net.ip?`IP: ${net.ip}`:null, (net.rssi!=null)?`RSSI: ${net.rssi} dBm`:null].filter(Boolean).join(' · '); $('#m_net').textContent=netStr||'–'; $('#m_uptime').textContent=fmtUptime(s.uptime_ms); }
