  const fmtUptime=(ms)=>{if(ms==null)return '–';const s=Math.floor(ms/1000);const d=Math.floor(s/86400);const h=Math.floor((s%86400)/3600);const m=Math.floor((s%3600)/60);return `${d}d ${h}h ${m}m`};
