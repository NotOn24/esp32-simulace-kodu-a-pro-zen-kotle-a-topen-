  }
  function chooseNiceStep(min,max,minT,maxT){const span=Math.max(1e-9,max-min); const raw=span/((minT+maxT)/2); const mag=Math.pow(10,Math.floor(Math.log10(raw))); const norm=raw/mag; let step; if(norm<1.5) step=1; else if(norm<3) step=2; else if(norm<7) step=5; else step=10; return step*mag;}
  function chooseTimeStep(xmin,xmax){const span=Math.max(1e3,xmax-xmin); const c=[60e3,2*60e3,5*60e3,10*60e3,15*60e3,30*60e3,60*60e3]; for(const k of c){if(span/k<=6) return k;} return c[c.length-1];}
