    collect(){return {name:$('.name',this.el).value,target:Number($('.target',this.el).value),enabled:$('.enabled',this.el).checked};}
    update(r,ymin,ymax){$('[data-role=tNow]',this.el).textContent=fmt(r.temp); $('[data-role=delta]',this.el).textContent=fmt((r.temp??0)-(r.target??0)); const pill=$('[data-role=valvePill]',this.el); pill.textContent='Ventil: '+(r.heating?'Otevřen':'Zavřen'); pill.classList.toggle('open',!!r.heating); pill.classList.toggle('closed',!r.heating); if(!this.editing){$('.name',this.el).value=r.name; $('.target',this.el).value=fmt(r.target); $('.enabled',this.el).checked=!!r.enabled;} const series=normalizeHistory(r.history,r.temp); this.chart.setRange(series.xmin,series.xmax,ymin,ymax); this.chart.setData([{name:'T',data:series.points}]);}
  }
  function normalizeHistory(h,fallback){const pts=[]; let xmin=now()-30*60e3,xmax=now(); if(Array.isArray(h)&&h.length){ if(typeof h[0]==='number'){const dt=60e3; const start=now()-(h.length-1)*dt; h.forEach((y,i)=>pts.push({t:start+i*dt,y}));} else if(typeof h[0]==='object'&&'t'in h[0]&&'y'in h[0]){h.forEach(p=>pts.push({t:p.t,y:p.y}));} xmin=pts[0]?.t??xmin; xmax=pts[pts.length-1]?.t??xmax; } else { const dt=60e3; const start=now()-30*dt; for(let i=0;i<=30;i++) pts.push({t:start+i*dt,y:fallback??20}); xmin=pts[0].t; xmax=pts[pts.length-1].t; } return {points:pts,xmin,xmax};}

  /* ===== Aplikace ===== */
  class App{ constructor(){this.state=null;this.timer=null;this.rooms=[];this.ymin=16;this.ymax=24;} async init(){this.bind(); await this.refresh(true); this.startTimer(Number($('#refreshRate').value||1000));} bind(){ $('#refresh').addEventListener('click',()=>this.refresh()); $('#refreshRate').addEventListener('change',e=>this.startTimer(Number(e.target.value))); $('#toggleBoiler').addEventListener('click',async()=>{try{await postJSON(API.toggleBoiler,{});this.refresh();}catch(e){console.warn(e);}}); $('#saveComfort').addEventListener('click',async()=>{const v=Number($('#comfortBand').value); try{await postJSON(API.comfort,{value:v}); this.refresh();}catch(e){console.warn(e);}}); $('#yMin').addEventListener('change',()=>{this.ymin=Number($('#yMin').value); this.renderRooms();}); $('#yMax').addEventListener('change',()=>{this.ymax=Number($('#yMax').value); this.renderRooms();}); }
