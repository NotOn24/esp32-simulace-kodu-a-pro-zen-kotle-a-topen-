  /* ===== Jednoduchý line chart ===== */
  class LineChart{ constructor(c,o={}){this.c=c;this.ctx=c.getContext('2d');this.o=Object.assign({pad:{l:34,t:12,r:10,b:24},font:'11px system-ui',grid:'#1f2a3b',text:'#8a94a7',line:'#5491ff'},o); this.resize(); window.addEventListener('resize',debounce(()=>this.resize(),120));}
    resize(){const r=this.c.getBoundingClientRect(); this.c.width=Math.max(240,Math.floor(r.width*dpr)); this.c.height=Math.max(120,Math.floor(r.height*dpr)); this.ctx.setTransform(dpr,0,0,dpr,0,0); this.draw();}
