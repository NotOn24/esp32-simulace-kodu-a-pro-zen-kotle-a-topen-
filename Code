/*********************************** BLOK C – DATOVÉ STRUKTURY ****************************/
struct Room{ // heating == ventil otevřen
  String name; float temp; float target; bool heating; bool enabled; float history[HISTORY_LEN]; unsigned long boostUntil;
};

// Výchozí zóny (5 ks) – pro přidání stačí rozšířit pole a změnit ROOM_COUNT
Room rooms[ROOM_COUNT]={
  {"Obývák",   20.2f, 21.5f, false, true, {0}, 0},
  {"Kuchyň",   19.8f, 20.5f, false, true, {0}, 0},
  {"Ložnice",  19.5f, 20.0f, false, true, {0}, 0},
  {"Pracovna", 20.0f, 20.5f, false, true, {0}, 0},
  {"Koupelna", 22.0f, 23.0f, false, true, {0}, 0}
};

/*********************************** BLOK D – GLOBÁLNÍ STAV SYSTÉMU ************************/
WebServer server(80);
bool  boilerOn=false; bool pumpOn=false; float boilerTemp=45.0f; float comfortBand=2.0f;
unsigned long uptimeStart=0,lastSim=0,lastLogic=0;

/*********************************** BLOK E – POMOCNÉ FUNKCE ********************************/
static inline float clampf(float v,float a,float b){return v<a?a:(v>b?b:v);}
static bool readBoundedFloat(const JsonVariantConst &src,float minVal,float maxVal,float &out,bool clamp){
  if(src.isNull()) return false;
  if(!(src.is<float>()||src.is<double>()||src.is<int>()||src.is<long>())) return false;
  float raw=src.as<float>();
  if(isnan(raw)||isinf(raw)) return false;
  if(raw<minVal){
    if(!clamp) return false;
    raw=minVal;
  }else if(raw>maxVal){
    if(!clamp) return false;
    raw=maxVal;
  }
  out=raw;
  return true;
}
static bool readBoundedInt(const JsonVariantConst &src,int minVal,int maxVal,int &out,bool clamp){
  if(src.isNull()) return false;
  long value=0;
  if(src.is<bool>()){
    value=src.as<bool>()?1:0;
  }else if(src.is<int>()||src.is<long>()){
    value=src.as<long>();
  }else if(src.is<float>()||src.is<double>()){
    float raw=src.as<float>();
    if(isnan(raw)||isinf(raw)) return false;
    long rounded=(long)raw;
    if(fabsf(raw-(float)rounded)>0.0001f) return false;
    value=rounded;
  }else{
    return false;
  }
  if(value<minVal){
    if(!clamp) return false;
    value=minVal;
  }else if(value>maxVal){
    if(!clamp) return false;
    value=maxVal;
  }
  out=(int)value;
  return true;
}
static bool readStrictBool(const JsonVariantConst &src,bool &out){
  if(src.isNull()) return false;
  if(src.is<bool>()){
    out=src.as<bool>();
    return true;
  }
  if(src.is<int>()||src.is<long>()){
    long value=src.as<long>();
    if(value==0){ out=false; return true; }
    if(value==1){ out=true; return true; }
  }
  return false;
}
void initHistory(){ for(int i=0;i<ROOM_COUNT;i++) for(int h=0;h<HISTORY_LEN;h++) rooms[i].history[h]=rooms[i].temp; }
void addCORS(){ server.sendHeader("Access-Control-Allow-Origin","*"); server.sendHeader("Access-Control-Allow-Headers","Content-Type"); server.sendHeader("Access-Control-Allow-Methods","GET,POST,OPTIONS"); }

/*********************************** BLOK F – SIMULACE A LOGIKA *****************************/
void simulateTemperatures(){
  for(int i=0;i<ROOM_COUNT;i++){
    Room &r=rooms[i];
    if(!r.enabled){ r.heating=false; for(int h=0;h<HISTORY_LEN-1;h++) r.history[h]=r.history[h+1]; r.history[HISTORY_LEN-1]=r.temp; continue; }
    const float halfBand=comfortBand*0.5f; bool shouldOpen=r.heating;
    if(millis()<r.boostUntil) shouldOpen=true; else { if(r.temp<r.target-halfBand) shouldOpen=true; if(r.temp>r.target+halfBand) shouldOpen=false; }
    if(r.heating && !shouldOpen) r.temp+=0.5f; // dojezd
    r.heating=shouldOpen; const float drift=r.heating?+0.36f:-0.06f; r.temp=clampf(r.temp+drift,16.0f,24.0f);
    for(int h=0;h<HISTORY_LEN-1;h++) r.history[h]=r.history[h+1]; r.history[HISTORY_LEN-1]=r.temp;
  }
}
void evaluateBoiler(){ bool anyOpen=false; for(int i=0;i<ROOM_COUNT;i++) if(rooms[i].enabled && rooms[i].heating){ anyOpen=true; break; } boilerOn=anyOpen; pumpOn=anyOpen; boilerTemp=clampf(boilerTemp+(anyOpen?+0.4f:-0.25f),25.0f,65.0f); digitalWrite(BOILER_RELAY,boilerOn?HIGH:LOW); }

/*********************************** BLOK G – REST API **************************************/
void apiState(){ addCORS(); DynamicJsonDocument doc(16384); doc["boiler_on"]=boilerOn; doc["pump_on"]=pumpOn; doc["boiler_temp"]=boilerTemp; doc["comfort_band"]=comfortBand; doc["uptime_ms"]=millis()-uptimeStart; JsonObject net=doc.createNestedObject("net"); net["ssid"]="ESP32_HeatingHub"; net["ip"]=WiFi.softAPIP().toString(); net["rssi"]=-50; JsonArray jRooms=doc.createNestedArray("rooms"); for(int i=0;i<ROOM_COUNT;i++){ JsonObject jr=jRooms.createNestedObject(); jr["name"]=rooms[i].name; jr["temp"]=rooms[i].temp; jr["target"]=rooms[i].target; jr["enabled"]=rooms[i].enabled; jr["heating"]=rooms[i].heating; JsonArray h=jr.createNestedArray("history"); for(int k=0;k<HISTORY_LEN;k++) h.add(rooms[i].history[k]); } String json; serializeJson(doc,json); server.send(200,"application/json",json); }
void apiSetRoom(){ addCORS(); if(!server.hasArg("plain")){ server.send(400,"text/plain","Missing body"); return;} DynamicJsonDocument d(512); if(deserializeJson(d,server.arg("plain"))){ server.send(400,"text/plain","Bad JSON"); return;} int idx=d["index"]|-1; if(idx<0||idx>=ROOM_COUNT){ server.send(400,"text/plain","Bad index"); return;} if(d.containsKey("name")) rooms[idx].name=(const char*)d["name"]; float newTarget; if(readBoundedFloat(d["target"],10.0f,30.0f,newTarget,true)) rooms[idx].target=newTarget; bool newEnabled; if(readStrictBool(d["enabled"],newEnabled)){ rooms[idx].enabled=newEnabled; if(!newEnabled){ rooms[idx].heating=false; rooms[idx].boostUntil=0; } } server.send(200,"application/json","{\"ok\":true}"); }
void apiToggleBoiler(){ addCORS(); boilerOn=!boilerOn; pumpOn=boilerOn; server.send(200,"application/json","{\"ok\":true}"); }
void apiComfort(){ addCORS(); if(!server.hasArg("plain")){ server.send(400,"text/plain","Missing body"); return;} DynamicJsonDocument d(256); if(deserializeJson(d,server.arg("plain"))){ server.send(400,"text/plain","Bad JSON"); return;} float newBand; if(!readBoundedFloat(d["value"],0.0f,5.0f,newBand,false)){ server.send(400,"text/plain","Invalid value"); return;} comfortBand=newBand; server.send(200,"application/json","{\"ok\":true}"); }
void apiBoost(){ addCORS(); if(!server.hasArg("plain")){ server.send(400,"text/plain","Missing body"); return;} DynamicJsonDocument d(256); if(deserializeJson(d,server.arg("plain"))){ server.send(400,"text/plain","Bad JSON"); return;} int idx=d["index"]|-1; if(idx<0||idx>=ROOM_COUNT){ server.send(400,"text/plain","Bad index"); return;} int minutes; if(!readBoundedInt(d["minutes"],1,240,minutes,false)){ server.send(400,"text/plain","Invalid minutes"); return;} rooms[idx].boostUntil=millis()+(unsigned long)minutes*60000UL; server.send(200,"application/json","{\"ok\":true}"); }

/*********************************** BLOK H – STATIC OBSAH & ROUTING ************************/
void handleIndex(){ addCORS(); server.send_P(200,"text/html",INDEX_HTML); }
void handleFavicon(){ server.send(204,"text/plain",""); }
void handleOptions(){ addCORS(); server.send(200,"text/plain",""); }

/*********************************** BLOK I – SETUP & LOOP **********************************/
void setup(){ Serial.begin(115200); pinMode(BOILER_RELAY,OUTPUT); digitalWrite(BOILER_RELAY,LOW); initHistory(); WiFi.mode(WIFI_AP); WiFi.softAP("ESP32_HeatingHub","12345678"); delay(120); Serial.print("AP běží na: http://"); Serial.println(WiFi.softAPIP()); server.on("/",HTTP_GET,handleIndex); server.on("/favicon.ico",HTTP_GET,handleFavicon); server.on("/api/state",HTTP_GET,apiState); server.on("/api/set_room",HTTP_POST,apiSetRoom); server.on("/api/boiler/toggle",HTTP_POST,apiToggleBoiler); server.on("/api/comfort_band",HTTP_POST,apiComfort); server.on("/api/boost",HTTP_POST,apiBoost); server.onNotFound([](){ if(server.method()==HTTP_OPTIONS) handleOptions(); else server.send(404,"text/plain","Not found"); }); server.begin(); uptimeStart=millis(); }
void loop(){ server.handleClient(); unsigned long t=millis(); if(t-lastSim>=750){ simulateTemperatures(); lastSim=t; } if(t-lastLogic>=1000){ evaluateBoiler(); lastLogic=t; } }
